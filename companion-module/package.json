{
	"name": "companion-module-iso-recorder",
	"version": "0.1.0",
	"description": "Bitfocus Companion control for ISO Recorder: record, arm and disarm inputs, with tally feedback.",
	"main": "dist/main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"format": "prettier -w .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint:raw": "eslint",
		"lint": "run lint:raw ."
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/notandrewjones/recording-app.git",
		"directory": "companion-module"
	},
	"engines": {
		"node": "^22.20",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "~2.0.4"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.2.0",
		"@types/node": "^22.20.5",
		"eslint": "^10.12.0",
		"prettier": "^3.9.9",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^7.3.7",
		"vitest": "~5.0.5"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"packageManager": "yarn@4.18.1"
}
