# Copy to scripts/signing.env (git-ignored). build_release.sh and notarize.sh load it when present.
# With no team ID, build_release.sh makes an ad-hoc archive and stops.

# Apple Team ID, 10 characters.
ISO_DEVELOPMENT_TEAM=""

# Must be a Developer ID Application certificate in the login keychain.
ISO_SIGN_IDENTITY="Developer ID Application"

# A notarytool profile in the keychain. Create one with:
#   xcrun notarytool store-credentials "ISORecorder-Notary" \
#     --key AuthKey_XXXX.p8 --key-id XXXX --issuer <issuer-uuid>
NOTARY_PROFILE="ISORecorder-Notary"
